# Copy to a private .env file. Use a NEW private data folder for EVERY server.
AMP_MUSIC_PATH=/srv/amp-music
AMP_DATA_PATH=/var/lib/amp-verse
AMP_UID=1000
AMP_GID=1000
AMP_BIND_ADDRESS=127.0.0.1
AMP_PORT=8787
AMP_CAST_PASSWORD=
AMP_CAST_IMAGE=ghcr.io/gitwide-cloud/amp-verse-cast:edge-amd64
AMP_CPU_LIMIT=1.0
AMP_MEMORY_LIMIT=512m
