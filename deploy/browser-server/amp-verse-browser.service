[Unit]
Description=AMP Verse browser studio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sager
Group=sager
WorkingDirectory=/srv/sager-work/sager/services/amp-verse-browser
EnvironmentFile=/srv/sager-work/sager/services/amp-verse-browser/server.env
ExecStart=/srv/sager-work/sager/services/amp-verse-browser/bin/amp-cast ${AMP_CAST_MUSIC_ROOT}
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/sager-work/sager/services/amp-verse-browser
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
